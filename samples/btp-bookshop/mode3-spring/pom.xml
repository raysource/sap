<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- 参考 pom：推荐直接用 start.spring.io 生成（见 README），
	     只需把下面 ngdbc 依赖块加入生成好的 pom.xml。 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Spring Boot 版本以 start.spring.io 生成的实际版本为准，此处仅示意 -->
		<version>3.3.4</version>
		<relativePath/>
	</parent>
	<groupId>com.acme</groupId>
	<artifactId>bookshop-spring</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>bookshop-spring</name>
	<description>BTP 手顺6：Spring Boot 读 HANA Cloud Bookshop</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- SAP HANA JDBC 驱动（版本以 Maven Central 为准） -->
		<dependency>
			<groupId>com.sap.cloud.db.jdbc</groupId>
			<artifactId>ngdbc</artifactId>
			<version>2.28.8</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
